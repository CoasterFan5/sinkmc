{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "SinkMC Api"
  },
  "components": {
    "schemas": {
      "sessionResp": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/user"
          },
          "session": {
            "$ref": "#/components/schemas/token"
          }
        },
        "required": [
          "user",
          "session"
        ]
      },
      "user": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "pfpUrl": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "userName",
          "email",
          "pfpUrl"
        ]
      },
      "token": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "nullable": true,
            "enum": [
              "WEB_SESSION",
              "API_KEY",
              null
            ]
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "scopes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "nullable": true
              },
              {
                "type": "object",
                "additionalProperties": {
                  "nullable": true
                }
              },
              {
                "type": "array",
                "items": {
                  "nullable": true
                }
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "userId",
          "type",
          "name",
          "scopes",
          "createdAt",
          "expiresAt"
        ]
      },
      "authResponseSchema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "tokenHash": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "tokenHash"
        ]
      },
      "status": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/session": {
      "get": {
        "security": [
          {
            "auth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Details about the user and token used to acquire the user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/sessionResp"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/github": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  }
                },
                "required": [
                  "code"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A private route to handle generation of tokens and auth. This route will not work if the code query param is not generated using the correct oAuth app.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/authResponseSchema"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "BAD_TOKEN"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "EXPIRED_CREDENTIALS",
                        "NO_VERIFIED_EMAIL"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "INTERNAL_ERROR",
                        "EXISTING_ACCOUNT"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/resources/{locator}": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "sink"
            },
            "required": true,
            "name": "locator",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "A single resource",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resource": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "ownerId": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "slug": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "category": {
                          "type": "string",
                          "enum": [
                            "Administration",
                            "Tools",
                            "Security",
                            "Social",
                            "Optimization",
                            "Mechanics",
                            "Libraries",
                            "World Generation",
                            "Economy",
                            "Cosmetics",
                            "Minigames"
                          ]
                        },
                        "price": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "createdAt": {
                          "type": "string",
                          "nullable": true,
                          "format": "date-time"
                        },
                        "updatedAt": {
                          "type": "string",
                          "nullable": true,
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "id",
                        "ownerId",
                        "name",
                        "slug",
                        "description",
                        "category",
                        "price",
                        "createdAt",
                        "updatedAt"
                      ],
                      "example": {
                        "id": "_",
                        "ownerId": "_",
                        "name": "My Cool Plugin",
                        "slug": "my-cool-plugin",
                        "description": "A very very neat plugin",
                        "category": "Mechanics",
                        "price": 0,
                        "createdAt": "2026-08-01T16:40:25.000Z",
                        "updatedAt": "2026-08-01T16:40:25.000Z"
                      }
                    }
                  },
                  "required": [
                    "resource"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "NOT_FOUND"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "INTERNAL_ERROR"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/resources": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Filter resources by ownerId"
            },
            "required": false,
            "description": "Filter resources by ownerId",
            "name": "ownerId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of resources",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resources": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "ownerId": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "slug": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "category": {
                            "type": "string",
                            "enum": [
                              "Administration",
                              "Tools",
                              "Security",
                              "Social",
                              "Optimization",
                              "Mechanics",
                              "Libraries",
                              "World Generation",
                              "Economy",
                              "Cosmetics",
                              "Minigames"
                            ]
                          },
                          "price": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "createdAt": {
                            "type": "string",
                            "nullable": true,
                            "format": "date-time"
                          },
                          "updatedAt": {
                            "type": "string",
                            "nullable": true,
                            "format": "date-time"
                          }
                        },
                        "required": [
                          "id",
                          "ownerId",
                          "name",
                          "slug",
                          "description",
                          "category",
                          "price",
                          "createdAt",
                          "updatedAt"
                        ],
                        "example": {
                          "id": "_",
                          "ownerId": "_",
                          "name": "My Cool Plugin",
                          "slug": "my-cool-plugin",
                          "description": "A very very neat plugin",
                          "category": "Mechanics",
                          "price": 0,
                          "createdAt": "2026-08-01T16:40:25.000Z",
                          "updatedAt": "2026-08-01T16:40:25.000Z"
                        }
                      }
                    }
                  },
                  "required": [
                    "resources"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "INTERNAL_ERROR"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Looking Good!",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/status"
                }
              }
            }
          }
        }
      }
    }
  }
}